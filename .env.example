# Firebase project that receives the install and open events (src/tracking.ts).
# Copy to .env.local and fill in, or leave unset: with either value missing, tracking
# turns itself off and the app behaves exactly as it did before.
#
# Both values come from Firebase console > Project settings > General > Your apps > SDK
# setup and configuration. Neither is a secret — the web API key identifies the project
# and ships in every Firebase client — so what keeps the collection safe is
# firestore.rules, not these.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
